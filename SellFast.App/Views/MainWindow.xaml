<Window x:Class="SellFast.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SellFast.App.ViewModels"
        xmlns:pages="clr-namespace:SellFast.App.Views.Pages"
        mc:Ignorable="d"
        Title="SellFast POS — Punto de Venta Universal"
        Height="840" Width="1300"
        MinHeight="650" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{StaticResource BgCanvasBrush}"
        Icon="pack://application:,,,/Resources/app.ico">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <pages:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PosViewModel}">
            <pages:PosView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductosViewModel}">
            <pages:ProductosView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ClientesViewModel}">
            <pages:ClientesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MesasViewModel}">
            <pages:MesasView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ComandasViewModel}">
            <pages:ComandasView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CajaViewModel}">
            <pages:CajaView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EmpleadosViewModel}">
            <pages:EmpleadosView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportesViewModel}">
            <pages:ReportesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConfiguracionViewModel}">
            <pages:ConfiguracionView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FichosViewModel}">
            <pages:FichosView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuditoriaViewModel}">
            <pages:AuditoriaView/>
        </DataTemplate>
    </Window.Resources>

    <Border CornerRadius="20" Background="{StaticResource BgCanvasBrush}" ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Dark Navy Sidebar (240px) -->
                <ColumnDefinition Width="240"/>
                <!-- Main Canvas Content Area -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- SIDEBAR NAVIGATION (Prodex Dark Charcoal)              -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Brand Header -->
                        <RowDefinition Height="*"/>    <!-- Navigation Menu -->
                        <RowDefinition Height="Auto"/> <!-- User Profile Footer -->
                    </Grid.RowDefinitions>

                    <!-- Brand Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="24,28,24,24">
                        <Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource AccentLimeBrush}" Margin="0,0,12,0" ClipToBounds="True">
                            <Grid>
                                <TextBlock Text="⚡" FontSize="20" Foreground="{StaticResource SidebarBgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Config.LogoRuta, Converter={StaticResource InverseStringToVisibilityConverter}}"/>
                                <Image Source="{Binding Config.LogoRuta}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Config.LogoRuta, Converter={StaticResource StringToVisibilityConverter}}"/>
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Config.NombreNegocio, FallbackValue='SellFast POS'}" FontSize="18" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                            <TextBlock Text="{Binding Config.Eslogan, FallbackValue='POS SYSTEM'}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentLimeBrush}" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Navigation Items -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,4">
                            <TextBlock Text="Overview" Style="{StaticResource SectionTitle}"/>

                            <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding NavegarADashboardCommand}" IsChecked="True">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📊 " FontSize="14" Margin="0,0,10,0"/>
                                    <TextBlock Text="Dashboard"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding NavegarAPosCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🛒 " FontSize="14" Margin="0,0,10,0"/>
                                    <TextBlock Text="Punto de Venta"/>
                                </StackPanel>
                            </RadioButton>

                            <TextBlock Text="Gestión" Style="{StaticResource SectionTitle}"/>

                            <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding NavegarAProductosCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📦 " FontSize="14" Margin="0,0,10,0"/>
                                    <TextBlock Text="Productos &amp; Stock"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding NavegarAClientesCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👥 " FontSize="14" Margin="0,0,10,0"/>
                                    <TextBlock Text="Clientes"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding NavegarAMesasCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🍽️ " FontSize="14" Margin="0,0,10,0"/>
                                    <TextBlock Text="Mesas &amp; Salón"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding NavegarAComandasCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📋 " FontSize="14" Margin="0,0,10,0"/>
                                    <TextBlock Text="Comandas Cocina"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding NavegarAEmpleadosCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👨‍💼 " FontSize="14" Margin="0,0,10,0"/>
                                    <TextBlock Text="Empleados"/>
                                </StackPanel>
                            </RadioButton>

                            <TextBlock Text="Control &amp; Ajustes" Style="{StaticResource SectionTitle}"/>

                            <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding NavegarACajaCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💵 " FontSize="14" Margin="0,0,10,0"/>
                                    <TextBlock Text="Caja Diaria"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding NavegarAReportesCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📈 " FontSize="14" Margin="0,0,10,0"/>
                                    <TextBlock Text="Reportes"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding NavegarAFichosCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎫 " FontSize="14" Margin="0,0,10,0"/>
                                    <TextBlock Text="Fichos"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding NavegarAAuditoriaCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📜 " FontSize="14" Margin="0,0,10,0"/>
                                    <TextBlock Text="Auditoría &amp; Logs"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding NavegarAConfiguracionCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙️ " FontSize="14" Margin="0,0,10,0"/>
                                    <TextBlock Text="Configuración"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- User Footer Profile -->
                    <Border Grid.Row="2" Padding="16,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{StaticResource AccentLimeBrush}" Margin="0,0,10,0">
                                <TextBlock Text="{Binding Sesion.Iniciales, FallbackValue='AD'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource SidebarBgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Sesion.NombreCompleto, FallbackValue='Administrador'}" FontSize="13" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Sesion.Rol, FallbackValue='Administrador'}" FontSize="11" Foreground="{StaticResource SidebarTextBrush}"/>
                            </StackPanel>

                            <Button Grid.Column="2" Content="🚪" Style="{StaticResource GhostButton}" Background="Transparent" Foreground="{StaticResource SidebarTextBrush}" Padding="6,4"
                                    Command="{Binding CerrarSesionCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="Cerrar Sesión"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- MAIN CONTENT AREA (Crisp Light Canvas)                 -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Grid Grid.Column="1" Background="{StaticResource BgCanvasBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="76"/> <!-- Header Top Bar -->
                    <RowDefinition Height="*"/>  <!-- Active Page Canvas -->
                </Grid.RowDefinitions>

                <!-- Header Top Bar -->
                <Border Grid.Row="0" MouseDown="TopBar_MouseDown" Padding="28,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Section Title -->
                        <TextBlock Grid.Column="0" Text="{Binding ActiveSectionTitle}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                        <!-- Search Pill Input (Prodex Top Bar Style) -->
                        <Border Grid.Column="1" Width="260" Height="40" Background="White" CornerRadius="20" Padding="14,0" Margin="0,0,16,0" VerticalAlignment="Center"
                                BorderBrush="#CBD5E1" BorderThickness="1.5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍 " FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1" Background="Transparent" BorderThickness="0" 
                                         Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"
                                         Tag="Search...."/>
                            </Grid>
                        </Border>

                        <!-- Window Controls -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="—" Style="{StaticResource GhostButton}" Width="36" Height="36" Padding="0" Click="MinimizeWindow_Click" Margin="0,0,4,0"/>
                            <Button Content="☐" Style="{StaticResource GhostButton}" Width="36" Height="36" Padding="0" Click="MaximizeWindow_Click" Margin="0,0,4,0"/>
                            <Button Content="✕" Style="{StaticResource GhostButton}" Width="36" Height="36" Padding="0" Click="CloseWindow_Click" Foreground="{StaticResource ErrorRedBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Page Content Presenter -->
                <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
            </Grid>

        </Grid>
    </Border>
</Window>
