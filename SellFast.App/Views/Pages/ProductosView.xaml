<UserControl x:Class="SellFast.App.Views.Pages.ProductosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100">

    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Top Action Bar -->
                <RowDefinition Height="*"/>    <!-- Data Table / Grid -->
            </Grid.RowDefinitions>

            <!-- Top Action Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search input -->
                <TextBox Grid.Column="0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource ModernTextBox}" Tag="Buscar producto por código o nombre..."/>

                <!-- Filter Checkbox -->
                <CheckBox Grid.Column="1" Content="Mostrar solo stock bajo" 
                          IsChecked="{Binding SoloStockBajo}" 
                          Foreground="{StaticResource TextSecondaryBrush}" 
                          VerticalAlignment="Center" Margin="16,0,0,0" FontSize="13"/>

                <!-- New Product Button -->
                <Button Grid.Column="3" Content="+ Nuevo Producto" 
                        Style="{StaticResource PrimaryButton}" 
                        Command="{Binding NuevoProductoCommand}" 
                        Padding="20,10"/>
            </Grid>

            <!-- Main Content Area (Table & Optional Edit Modal) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <!-- Side Edit Panel (Visible when IsEditing is True) -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Products List Table -->
                <Border Grid.Column="0" Background="White" CornerRadius="20" Padding="16" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Productos}">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <StackPanel IsItemsHost="True"/>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="8,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Code -->
                                            <TextBlock Grid.Column="0" Text="{Binding Codigo}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>

                                            <!-- Name & Category -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Nombre}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Categoria}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>

                                            <!-- Price -->
                                            <TextBlock Grid.Column="2" Text="{Binding Precio, Converter={StaticResource CurrencyFormatterConverter}}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                                            <!-- Stock Badge -->
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StockDisponible, StringFormat='{}Stock: {0}'}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding EstadoStock}" FontSize="11" Foreground="{StaticResource WarningOrangeBrush}"/>
                                            </StackPanel>

                                            <!-- Actions -->
                                            <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Editar" Style="{StaticResource GhostButton}" Command="{Binding DataContext.EditarProductoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,4,0"/>
                                                <Button Content="Eliminar" Style="{StaticResource GhostButton}" Foreground="{StaticResource ErrorRedBrush}" Command="{Binding DataContext.EliminarProductoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Edit Product Side Form -->
                <Border Grid.Column="1" Width="360" Margin="16,0,0,0" 
                        Background="White" CornerRadius="20" Padding="20" 
                        BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                        Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Datos del Producto" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20"/>

                            <TextBlock Text="CÓDIGO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding ProductoActual.Codigo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"/>

                            <TextBlock Text="NOMBRE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding ProductoActual.Nombre, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"/>

                            <TextBlock Text="CATEGORÍA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding CategoriasDisponibles}" SelectedItem="{Binding ProductoActual.Categoria}" Height="38" Margin="0,0,0,16"/>

                            <TextBlock Text="PRECIO DE VENTA ($)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding ProductoActual.Precio, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"/>

                            <TextBlock Text="STOCK ACTUAL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding ProductoActual.StockDisponible, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"/>

                            <TextBlock Text="STOCK MÍNIMO ALERTA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding ProductoActual.StockMinimo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,20"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancelar" Style="{StaticResource GhostButton}" Command="{Binding CancelarEdicionCommand}" Margin="0,0,8,0"/>
                                <Button Content="Guardar Producto" Style="{StaticResource PrimaryButton}" Command="{Binding GuardarProductoCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

            </Grid>
        </Grid>
    </Border>
</UserControl>
