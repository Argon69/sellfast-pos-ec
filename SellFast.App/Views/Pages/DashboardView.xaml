<UserControl x:Class="SellFast.App.Views.Pages.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Padding="28,12,28,28">
            <StackPanel>

                <!-- Greeting Header -->
                <Grid Margin="0,0,0,24">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding GreetingText, FallbackValue='Bienvenido a SellFast POS 👋'}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Resumen de rendimiento y ventas en tiempo real." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border CornerRadius="14" Background="White" Padding="14,8" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🟢 POS Activo" FontSize="12" FontWeight="Bold" Foreground="{StaticResource SuccessGreenBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- KPI Cards Row (Prodex Style 4 Cards) -->
                <UniformGrid Columns="4" Margin="-6,0,-6,24">

                    <!-- Card 1: Dark Primary Card (Prodex Style Dark Card) -->
                    <Border Style="{StaticResource KpiCardDark}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Total Ventas Hoy" FontSize="13" FontWeight="SemiBold" Foreground="#9BA0B8"/>
                                <Border Width="28" Height="28" CornerRadius="8" Background="#282A3E" HorizontalAlignment="Right">
                                    <TextBlock Text="💰" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding VentasHoy, Converter={StaticResource CurrencyFormatterConverter}}" FontSize="26" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>

                            <StackPanel Orientation="Horizontal">
                                <Border CornerRadius="10" Background="#20D2F835" Padding="8,4" Margin="0,0,8,0">
                                    <TextBlock Text="↑ 35.7%" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentLimeBrush}"/>
                                </Border>
                                <TextBlock Text="vs ayer" FontSize="11" Foreground="#9BA0B8" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: White Card (Transacciones) -->
                    <Border Style="{StaticResource KpiCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Transacciones Hoy" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource BgPillBrush}" HorizontalAlignment="Right">
                                    <TextBlock Text="🧾" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding TransaccionesHoy}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                            <StackPanel Orientation="Horizontal">
                                <Border CornerRadius="10" Background="{StaticResource SuccessGreenBgBrush}" Padding="8,4" Margin="0,0,8,0">
                                    <TextBlock Text="↑ 45.2%" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessGreenBrush}"/>
                                </Border>
                                <TextBlock Text="órdenes activas" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: White Card (Fichos Pendientes) -->
                    <Border Style="{StaticResource KpiCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Fichos Pendientes" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource BgPillBrush}" HorizontalAlignment="Right">
                                    <TextBlock Text="🎫" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding FichosPendientes}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                            <StackPanel Orientation="Horizontal">
                                <Border CornerRadius="10" Background="{StaticResource WarningOrangeBgBrush}" Padding="8,4" Margin="0,0,8,0">
                                    <TextBlock Text="Pendientes" FontSize="11" FontWeight="Bold" Foreground="{StaticResource WarningOrangeBrush}"/>
                                </Border>
                                <TextBlock Text="por entregar" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Card 4: White Card (Productos Bajo Stock) -->
                    <Border Style="{StaticResource KpiCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Alertas de Stock" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource BgPillBrush}" HorizontalAlignment="Right">
                                    <TextBlock Text="⚠️" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding ProductosBajoStock}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                            <StackPanel Orientation="Horizontal">
                                <Border CornerRadius="10" Background="{StaticResource ErrorRedBgBrush}" Padding="8,4" Margin="0,0,8,0">
                                    <TextBlock Text="Bajo Stock" FontSize="11" FontWeight="Bold" Foreground="{StaticResource ErrorRedBrush}"/>
                                </Border>
                                <TextBlock Text="reabastecer" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </UniformGrid>

                <!-- Middle Content Section (2 Columns) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Recent Transactions Overview (Left White Card) -->
                    <Border Grid.Column="0" Background="White" CornerRadius="20" Padding="24" Margin="0,0,12,0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,20">
                                <TextBlock Text="Últimas Transacciones" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <Button Content="Ver Historial" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Padding="14,6"
                                        Command="{Binding DataContext.NavegarAReportesCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding ActividadReciente}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Time Badge Pill -->
                                                <Border Grid.Column="0" CornerRadius="10" Background="{StaticResource BgPillBrush}" Padding="10,6" Margin="0,0,14,0">
                                                    <TextBlock Text="{Binding Time}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </Border>

                                                <!-- Title & Subtitle -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </StackPanel>

                                                <!-- Amount -->
                                                <TextBlock Grid.Column="2" Text="{Binding Amount}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Quick Actions Card (Right White Card) -->
                    <Border Grid.Column="1" Background="White" CornerRadius="20" Padding="24" Margin="12,0,0,0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Acciones Rápidas" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20"/>

                            <Button Style="{StaticResource PrimaryButton}" Margin="0,0,0,12" Height="48"
                                    Command="{Binding DataContext.NavegarAPosCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🛒  " FontSize="15"/>
                                    <TextBlock Text="Nueva Venta (POS)"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource GhostButton}" Margin="0,0,0,10" Height="44" HorizontalContentAlignment="Left"
                                    Command="{Binding DataContext.NavegarACajaCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💵  " FontSize="15" Margin="0,0,10,0"/>
                                    <TextBlock Text="Abrir / Cerrar Caja"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource GhostButton}" Margin="0,0,0,10" Height="44" HorizontalContentAlignment="Left"
                                    Command="{Binding DataContext.NavegarAProductosCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📦  " FontSize="15" Margin="0,0,10,0"/>
                                    <TextBlock Text="Agregar Producto"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource GhostButton}" Height="44" HorizontalContentAlignment="Left"
                                    Command="{Binding DataContext.NavegarAReportesCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📈  " FontSize="15" Margin="0,0,10,0"/>
                                    <TextBlock Text="Generar Reporte"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                </Grid>

            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
