<Window x:Class="SellFast.App.Views.ModernDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SellFast POS — Notificación"
        Height="380" Width="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="24" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Padding="28" MouseDown="Window_MouseDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Icon Header -->
                <RowDefinition Height="Auto"/> <!-- Title -->
                <RowDefinition Height="*"/>    <!-- Message -->
                <RowDefinition Height="Auto"/> <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- Icon Header -->
            <Border Grid.Row="0" Width="52" Height="52" CornerRadius="16" x:Name="IconBadge" Background="{StaticResource BgPillBrush}" HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock x:Name="TxtIcon" Text="⚡" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Title -->
            <TextBlock Grid.Row="1" x:Name="TxtTitle" Text="Venta Procesada" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>

            <!-- Message Body -->
            <TextBlock Grid.Row="2" x:Name="TxtMessage" Text="La transacción se completó correctamente." 
                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" 
                       TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,0,20"/>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="BtnPdf" Content="📄 Abrir PDF" Style="{StaticResource PrimaryButton}" Click="BtnPdf_Click" Visibility="Collapsed" Margin="0,0,8,0" Padding="14,10"/>
                <Button x:Name="BtnPrimary" Content="💬 WhatsApp" Style="{StaticResource DarkButton}" Click="BtnPrimary_Click" Margin="0,0,8,0" Padding="14,10"/>
                <Button x:Name="BtnSecondary" Content="Cerrar" Style="{StaticResource GhostButton}" Click="BtnSecondary_Click" Visibility="Collapsed" Padding="14,10"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
